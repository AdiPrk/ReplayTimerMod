<Project Sdk="Microsoft.NET.Sdk">
  <!--
  Imports Hollow Knight path properties only if present.
  Keep this file local (gitignored) if you need machine-specific paths.
  -->
  <Import Condition="Exists('..\..\.config\local\HollowKnightPath1578.props')" Project="..\..\.config\local\HollowKnightPath1578.props" />

  <!-- Only the 1578-specific deltas live here; everything shared with the
       1221 target is in HK.Common.targets (imported at the bottom). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <HKVersionConstant>V1578</HKVersionConstant>
    <HKLocalPropsName>HollowKnightPath1578.props</HKLocalPropsName>
  </PropertyGroup>

  <ItemGroup Condition="'$(HollowKnightManagedFolder)' != ''">
    <Reference Include="MMHOOK_Assembly-CSharp" Condition="Exists('$(HollowKnightManagedFolder)\MMHOOK_Assembly-CSharp.dll')">
      <HintPath>$(HollowKnightManagedFolder)\MMHOOK_Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Condition="Exists('$(HollowKnightManagedFolder)\UnityEngine.InputLegacyModule.dll')">
      <HintPath>$(HollowKnightManagedFolder)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="HK.Common.targets" />
</Project>

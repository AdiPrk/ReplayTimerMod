<Project Sdk="Microsoft.NET.Sdk">
  <!--
  Imports Hollow Knight path properties only if present.
  Keep this file local (gitignored) if you need machine-specific paths.
  -->
  <Import Condition="Exists('..\..\.config\local\HollowKnightPath1221.props')" Project="..\..\.config\local\HollowKnightPath1221.props" />

  <!-- Only the 1221-specific deltas live here; everything shared with the
       1578 target is in HK.Common.targets (imported at the bottom). -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <HKVersionConstant>V1221</HKVersionConstant>
    <HKLocalPropsName>HollowKnightPath1221.props</HKLocalPropsName>
  </PropertyGroup>

  <Import Project="HK.Common.targets" />
</Project>
